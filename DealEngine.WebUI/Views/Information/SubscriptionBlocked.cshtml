@{
    var blockedMessage = ViewBag.BlockedMessage as string ?? "A previous subscription is still pending.";
    var pendingProgrammeId = ViewBag.PendingProgrammeId as Guid?;
    var pendingProgrammeName = ViewBag.PendingProgrammeName as string ?? "older pending subscription";
    var pendingUrl = pendingProgrammeId.HasValue ? "/Information/EditInformation/" + pendingProgrammeId.Value : "/Home/Index";
}

<div id="content" class="container" style="padding-top:24px; max-width: 900px;">
    <div class="card shadow-sm border-0" style="border-left: 6px solid #d9534f;">
        <div class="card-body" style="padding: 24px;">
            <h4 style="margin-top: 0; color: #b52b27;">Action to perform before starting current year Insurance</h4>
            <p id="blockedMessageText" style="font-size: 16px; margin-bottom: 16px;">@blockedMessage</p>

            <div class="d-flex" style="display:flex; gap: 10px; flex-wrap: wrap;">
                <a class="btn btn-warning" href="@pendingUrl">Open Older Pending Insurance</a>
                <a class="btn btn-secondary" href="javascript:history.back();">Go Back</a>
            </div>

            <div style="margin-top:12px; color:#555;">
                Pending subscription: <strong>@pendingProgrammeName</strong>
            </div>
        </div>
    </div>
</div>
